{
    "name": "caissedz/catalog-api",
    "description": "CaisseDZ Catalog API",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "firebase/php-jwt": "^6.0",
        "vlucas/phpdotenv": "^5.5",
        "monolog/monolog": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "CaisseDZ\\Catalog\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        },
        "disable-tls": false,
        "secure-http": true,
        "platform": {
            "php": "8.2.32"
        }
    },
    "extra": {
        "composer": {
            "policy": {
                "advisories": {
                    "block": false
                }
            }
        }
    }
}