RewriteCond %{HTTP_REFERER} !^http://www.bensds.com$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.catalog-api.bensds.com/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://www.catalog-api.bensds.com$      [NC]
