<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Allow direct access to files
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all requests to index.php, en conservant le chemin dans PATH_INFO
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>

# Security: Deny access to .env
<Files .env>
    Order allow,deny
    Deny from all
</Files>

# Security: Deny access to sensitive directories
RedirectMatch 403 ^/(config|models|controllers|services|middleware)/.*$

RewriteCond %{HTTP_REFERER} !^http://admin.bensds.com/.*$      [NC]
RewriteCond %{HTTP_REFERER} !^http://admin.bensds.com$      [NC]
